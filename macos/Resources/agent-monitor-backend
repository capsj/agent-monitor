#!/bin/zsh
set -euo pipefail

resource_dir="${0:A:h}"

node_path="${AGENT_MONITOR_NODE:-}"
if [[ -z "$node_path" && -f "$resource_dir/node-path" ]]; then
  node_path="$(<"$resource_dir/node-path")"
fi
if [[ -z "$node_path" && -n "${NVM_BIN:-}" && -x "$NVM_BIN/node" ]]; then
  node_path="$NVM_BIN/node"
fi
if [[ -z "$node_path" ]]; then
  node_path="$(command -v node || true)"
fi

# Prefer the checkout the app was built from, wherever the bundle now lives.
cli_path=""
if [[ -f "$resource_dir/cli-path" ]]; then
  cli_path="$(<"$resource_dir/cli-path")"
fi
if [[ -z "$cli_path" || ! -f "$cli_path" ]]; then
  cli_path="$resource_dir/../../../../dist/cli.js"
fi
if [[ -f "$cli_path" && -n "$node_path" && -x "$node_path" ]]; then
  exec "$node_path" "$cli_path" "$@"
fi

# Fall back to a globally installed CLI. A login shell restores the
# Homebrew/pnpm PATH that GUI applications do not normally inherit.
exec /bin/zsh -lc 'exec agent-monitor "$@"' agent-monitor "$@"
