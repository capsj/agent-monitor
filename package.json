{
  "name": "agent-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "An htop-style monitor for AI coding subscriptions and local agent usage.",
  "type": "module",
  "bin": {
    "agent-monitor": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "build:macos": "./scripts/build-macos-app.sh",
    "auth": "tsx src/cli.tsx auth",
    "dev": "tsx src/cli.tsx",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.61.1",
    "react": "^19.2.0",
    "strip-ansi": "^7.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  },
  "license": "MIT"
}
